        <mxCell id="lbl_zone_a" parent="1" value="&lt;b&gt;ZONE A — ACTEURS DU SYSTÈME&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor:#4F5D75;fontStyle=1;fontFamily=Georgia;" vertex="1"><mxGeometry x="35" y="16" width="300" height="20" as="geometry" /></mxCell>
        <mxCell id="lbl_zone_b" parent="1" value="&lt;b&gt;ZONE B — ESPACES D'ACCÈS &amp; CANAUX D'INTERACTION&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor:#4F5D75;fontStyle=1;fontFamily=Georgia;" vertex="1"><mxGeometry x="35" y="176" width="400" height="20" as="geometry" /></mxCell>
        <mxCell id="lbl_zone_c" parent="1" value="&lt;b&gt;ZONE C — MODULES FONCTIONNELS MÉTIER&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor:#4F5D75;fontStyle=1;fontFamily=Georgia;" vertex="1"><mxGeometry x="35" y="342" width="400" height="20" as="geometry" /></mxCell>
        <mxCell id="act_client" parent="1" value="&lt;div style=&quot;padding:8px 10px;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif;&quot;&gt;&lt;span style=&quot;font-size:8.5px;font-weight:700;color:#2D3142;background:#F1F5F9;border:1px solid #CBD5E1;padding:2px 5px;border-radius:3px;&quot;&gt;ACTEUR EXTERNE&lt;/span&gt;&lt;br/&gt;&lt;b style=&quot;font-size:13.5px;color:#2D3142;display:block;margin-top:4px;&quot;&gt;Client / Consommateur&lt;/b&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:6px;line-height:1.45;&quot;&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Accéder&lt;/b&gt; librement sans compte&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Déposer&lt;/b&gt; des réclamations &amp;amp; suivre&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Échanger&lt;/b&gt; en direct par tchat SAV&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;shadow=0;fillColor=#FFFFFF;strokeColor=#4F5D75;strokeWidth=1.0;verticalAlign=top;align=left;overflow=fill;html=1;" vertex="1"><mxGeometry x="35" y="38" width="350" height="120" as="geometry" /></mxCell>
        <mxCell id="act_internal" parent="1" value="&lt;div style=&quot;padding:8px 10px;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif;&quot;&gt;&lt;span style=&quot;font-size:8.5px;font-weight:700;color:#2D3142;background:#F1F5F9;border:1px solid #CBD5E1;padding:2px 5px;border-radius:3px;&quot;&gt;WORKSPACE MULTI-TENANT&lt;/span&gt;&lt;br/&gt;&lt;b style=&quot;font-size:13.5px;color:#2D3142;display:block;margin-top:4px;&quot;&gt;Collaborateurs de l&apos;Entreprise&lt;/b&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:6px;line-height:1.45;&quot;&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Conseiller (Agent)&lt;/b&gt; : Traiter tickets &amp;amp; SLA&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Superviseur (Manager)&lt;/b&gt; : Files &amp;amp; agences&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Administrateur (Owner)&lt;/b&gt; : Équipe &amp;amp; SasPay&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;shadow=0;fillColor=#FFFFFF;strokeColor=#4F5D75;strokeWidth=1.0;verticalAlign=top;align=left;overflow=fill;html=1;" vertex="1"><mxGeometry x="415" y="38" width="350" height="120" as="geometry" /></mxCell>
        <mxCell id="space_public" parent="1" value="&lt;div style=&quot;padding:8px 10px;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif;&quot;&gt;&lt;span style=&quot;font-size:8.5px;font-weight:700;color:#2D3142;background:#F1F5F9;border:1px solid #CBD5E1;padding:2px 5px;border-radius:3px;&quot;&gt;ENVIRONNEMENT PUBLIC&lt;/span&gt;&lt;br/&gt;&lt;b style=&quot;font-size:14px;color:#2D3142;display:block;margin-top:4px;font-family:Georgia,serif;&quot;&gt;Portail Public &amp;amp; Vitrine SAV&lt;/b&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:6px;line-height:1.45;&quot;&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Rechercher&lt;/b&gt; commerces certifiés (/entreprises)&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Consulter&lt;/b&gt; vitrine, adresses et horaires SAV&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Démarrer&lt;/b&gt; un tchat immédiat sécurisé par jeton&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;shadow=0;fillColor=#FFFFFF;strokeColor=#2D3142;strokeWidth=1.0;verticalAlign=top;align=left;overflow=fill;html=1;" vertex="1"><mxGeometry x="35" y="200" width="350" height="122" as="geometry" /></mxCell>
        <mxCell id="space_workspace" parent="1" value="&lt;div style=&quot;padding:8px 10px;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif;&quot;&gt;&lt;span style=&quot;font-size:8.5px;font-weight:700;color:#2D3142;background:#F1F5F9;border:1px solid #CBD5E1;padding:2px 5px;border-radius:3px;&quot;&gt;ESPACE SÉCURISÉ MULTI-TENANT&lt;/span&gt;&lt;br/&gt;&lt;b style=&quot;font-size:14px;color:#2D3142;display:block;margin-top:4px;font-family:Georgia,serif;&quot;&gt;Workspace Collaboratif Entreprise&lt;/b&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:6px;line-height:1.45;&quot;&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Cockpit Conseiller&lt;/b&gt; : Traitement tickets &amp;amp; SLA&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Console Supervision&lt;/b&gt; : Files, compétences &amp;amp; agences&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Administration&lt;/b&gt; : Équipe, abonnements &amp;amp; IA&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;shadow=0;fillColor=#FFFFFF;strokeColor=#2D3142;strokeWidth=1.0;verticalAlign=top;align=left;overflow=fill;html=1;" vertex="1"><mxGeometry x="415" y="200" width="350" height="122" as="geometry" /></mxCell>
        <mxCell id="mod_tickets" parent="1" value="&lt;div style=&quot;padding:8px 10px;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif;&quot;&gt;&lt;span style=&quot;font-size:8.5px;font-weight:700;color:#2D3142;background:#F1F5F9;border:1px solid #CBD5E1;padding:2px 5px;border-radius:3px;&quot;&gt;MODULE OPÉRATIONNEL&lt;/span&gt;&lt;br/&gt;&lt;b style=&quot;font-size:14px;color:#2D3142;display:block;margin-top:4px;font-family:Georgia,serif;&quot;&gt;1. Demandes &amp;amp; Tickets SAV&lt;/b&gt;&lt;div style=&quot;font-size:10.5px;color:#64748B;font-style:italic;margin-bottom:4px;&quot;&gt;Cycle de vie formalisé des réclamations&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #E2E8F0;margin:3px 0 6px 0;&quot;/&gt;&lt;div style=&quot;font-size:11px;color:#334155;line-height:1.45;&quot;&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Créer &amp;amp; Numéroter&lt;/b&gt; le dossier unique (TICK-ABC)&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Ordonnancer&lt;/b&gt; : PENDING → OPEN → RESOLVED&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Surveiller&lt;/b&gt; les SLA avec alertes d&apos;échéance&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Tracer&lt;/b&gt; dans le journal inaltérable (TicketActivity)&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Partager&lt;/b&gt; dossiers entre succursales et ateliers&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Joindre&lt;/b&gt; pièces justificatives (factures, photos)&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Clôturer&lt;/b&gt; avec motif formel de résolution&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;shadow=0;fillColor=#FFFFFF;strokeColor=#2D3142;strokeWidth=1.0;verticalAlign=top;align=left;overflow=fill;html=1;" vertex="1"><mxGeometry x="35" y="365" width="350" height="232" as="geometry" /></mxCell>
        <mxCell id="mod_conv" parent="1" value="&lt;div style=&quot;padding:8px 10px;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif;&quot;&gt;&lt;span style=&quot;font-size:8.5px;font-weight:700;color:#2D3142;background:#F1F5F9;border:1px solid #CBD5E1;padding:2px 5px;border-radius:3px;&quot;&gt;MODULE OPÉRATIONNEL&lt;/span&gt;&lt;br/&gt;&lt;b style=&quot;font-size:14px;color:#2D3142;display:block;margin-top:4px;font-family:Georgia,serif;&quot;&gt;2. Conversations &amp;amp; Dialogue Direct&lt;/b&gt;&lt;div style=&quot;font-size:10.5px;color:#64748B;font-style:italic;margin-bottom:4px;&quot;&gt;Messagerie instantanée omnicanale et tchat&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #E2E8F0;margin:3px 0 6px 0;&quot;/&gt;&lt;div style=&quot;font-size:11px;color:#334155;line-height:1.45;&quot;&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Échanger&lt;/b&gt; en temps réel entre client et conseiller&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Générer&lt;/b&gt; session sécurisée par jeton sans compte&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Consigner&lt;/b&gt; des notes confidentielles internes&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Élever&lt;/b&gt; instantanément le fil en Ticket SAV&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Réceptionner&lt;/b&gt; photos et documents justificatifs&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Indiquer&lt;/b&gt; présence et saisie en direct (SSE)&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Conserver&lt;/b&gt; l&apos;historique complet des échanges&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;shadow=0;fillColor=#FFFFFF;strokeColor=#2D3142;strokeWidth=1.0;verticalAlign=top;align=left;overflow=fill;html=1;" vertex="1"><mxGeometry x="415" y="365" width="350" height="232" as="geometry" /></mxCell>
        <mxCell id="mod_team" parent="1" value="&lt;div style=&quot;padding:8px 10px;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif;&quot;&gt;&lt;span style=&quot;font-size:8.5px;font-weight:700;color:#2D3142;background:#F1F5F9;border:1px solid #CBD5E1;padding:2px 5px;border-radius:3px;&quot;&gt;MODULE OPÉRATIONNEL&lt;/span&gt;&lt;br/&gt;&lt;b style=&quot;font-size:14px;color:#2D3142;display:block;margin-top:4px;font-family:Georgia,serif;&quot;&gt;3. Équipe, Compétences &amp;amp; Agences&lt;/b&gt;&lt;div style=&quot;font-size:10.5px;color:#64748B;font-style:italic;margin-bottom:4px;&quot;&gt;Ressources, qualifications et agences&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #E2E8F0;margin:3px 0 6px 0;&quot;/&gt;&lt;div style=&quot;font-size:11px;color:#334155;line-height:1.45;&quot;&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Réguler&lt;/b&gt; la charge via plafonds (maxCapacity)&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Déclarer&lt;/b&gt; statuts : AVAILABLE, BUSY, AWAY&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Classifier&lt;/b&gt; compétences techniques (Skills)&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Affecter&lt;/b&gt; automatiquement selon profil et charge&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Administrer&lt;/b&gt; les succursales et ateliers SAV&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Réassigner&lt;/b&gt; manuellement dossiers en pic&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Auditer&lt;/b&gt; la charge de traitement en direct&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;shadow=0;fillColor=#FFFFFF;strokeColor=#2D3142;strokeWidth=1.0;verticalAlign=top;align=left;overflow=fill;html=1;" vertex="1"><mxGeometry x="35" y="618" width="350" height="232" as="geometry" /></mxCell>
        <mxCell id="mod_sec" parent="1" value="&lt;div style=&quot;padding:8px 10px;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif;&quot;&gt;&lt;span style=&quot;font-size:8.5px;font-weight:700;color:#2D3142;background:#F1F5F9;border:1px solid #CBD5E1;padding:2px 5px;border-radius:3px;&quot;&gt;MODULE OPÉRATIONNEL&lt;/span&gt;&lt;br/&gt;&lt;b style=&quot;font-size:14px;color:#2D3142;display:block;margin-top:4px;font-family:Georgia,serif;&quot;&gt;4. Sécurité &amp;amp; Gestion des Accès&lt;/b&gt;&lt;div style=&quot;font-size:10.5px;color:#64748B;font-style:italic;margin-bottom:4px;&quot;&gt;Contrôle RBAC, étanchéité et traçabilité&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #E2E8F0;margin:3px 0 6px 0;&quot;/&gt;&lt;div style=&quot;font-size:11px;color:#334155;line-height:1.45;&quot;&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Sécuriser&lt;/b&gt; cookies HttpOnly, SameSite et OTP&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Contrôler&lt;/b&gt; strictement autorisations par rôle (RBAC)&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Cloisonner&lt;/b&gt; hermétiquement données par tenant&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Garantir&lt;/b&gt; persistance via l&apos;Outbox Pattern&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Diffuser&lt;/b&gt; en temps réel via Pulse Stream (SSE)&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Journaliser&lt;/b&gt; actions d&apos;administration (AuditLog)&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Bloquer&lt;/b&gt; abus par limitation de débit (Rate Limit)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;shadow=0;fillColor=#FFFFFF;strokeColor=#2D3142;strokeWidth=1.0;verticalAlign=top;align=left;overflow=fill;html=1;" vertex="1"><mxGeometry x="415" y="618" width="350" height="232" as="geometry" /></mxCell>
        <mxCell id="mod_comm" parent="1" value="&lt;div style=&quot;padding:8px 10px;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif;&quot;&gt;&lt;span style=&quot;font-size:8.5px;font-weight:700;color:#2D3142;background:#F1F5F9;border:1px solid #CBD5E1;padding:2px 5px;border-radius:3px;&quot;&gt;MODULE OPÉRATIONNEL&lt;/span&gt;&lt;br/&gt;&lt;b style=&quot;font-size:14px;color:#2D3142;display:block;margin-top:4px;font-family:Georgia,serif;&quot;&gt;5. Facturation &amp;amp; Abonnements&lt;/b&gt;&lt;div style=&quot;font-size:10.5px;color:#64748B;font-style:italic;margin-bottom:4px;&quot;&gt;Gestion commerciale SaaS et paiements&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #E2E8F0;margin:3px 0 6px 0;&quot;/&gt;&lt;div style=&quot;font-size:11px;color:#334155;line-height:1.45;&quot;&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Tarifer&lt;/b&gt; selon offres (Starter, Pro, Enterprise)&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Réguler&lt;/b&gt; dynamiquement quotas agents/tickets&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Encaisser&lt;/b&gt; via SasPay (Mobile Money &amp;amp; Cartes)&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Valider&lt;/b&gt; paiements par webhooks asynchrones&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Éditer&lt;/b&gt; factures comptables et historique&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Notifier&lt;/b&gt; l&apos;approche des échéances de forfait&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Renouveler&lt;/b&gt; forfaits à date anniversaire&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;shadow=0;fillColor=#FFFFFF;strokeColor=#2D3142;strokeWidth=1.0;verticalAlign=top;align=left;overflow=fill;html=1;" vertex="1"><mxGeometry x="35" y="872" width="350" height="242" as="geometry" /></mxCell>
        <mxCell id="mod_ai" parent="1" value="&lt;div style=&quot;padding:8px 10px;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif;&quot;&gt;&lt;span style=&quot;font-size:8.5px;font-weight:700;color:#EB6C36;background:#FDF0EB;border:1px solid #EB6C36;padding:2px 5px;border-radius:3px;&quot;&gt;ARCHITECTURE CIBLE • EN PRÉPARATION&lt;/span&gt;&lt;br/&gt;&lt;b style=&quot;font-size:14px;color:#2D3142;display:block;margin-top:4px;font-family:Georgia,serif;&quot;&gt;6. Assistance IA &amp;amp; RAG (Supervisée)&lt;/b&gt;&lt;div style=&quot;font-size:10.5px;color:#64748B;font-style:italic;margin-bottom:4px;&quot;&gt;Augmentation conseillers &amp;amp; garde-fous stricts&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #FDBA74;margin:3px 0 6px 0;&quot;/&gt;&lt;div style=&quot;font-size:11px;color:#334155;line-height:1.45;&quot;&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Ingérer&lt;/b&gt; manuels SAV et documentation (chunks)&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Rechercher&lt;/b&gt; sémantiquement &amp;amp; générer (Llama 3.3)&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Proposer&lt;/b&gt; des brouillons modifiables par l&apos;agent&lt;br/&gt;&lt;span style=&quot;color:#9A3412;&quot;&gt;&lt;b style=&quot;color:#EB6C36;&quot;&gt;Escalade humaine immédiate obligatoire :&lt;/b&gt;&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;color:#9A3412;font-size:10px;&quot;&gt;&amp;nbsp;&amp;nbsp;1. Détection d&apos;irritation client&lt;br/&gt;&amp;nbsp;&amp;nbsp;2. Litige financier &amp;gt; 50 000 XAF&lt;br/&gt;&amp;nbsp;&amp;nbsp;3. Demande explicite de conseiller humain&lt;/span&gt;&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Superviser&lt;/b&gt; avec score de confiance et validation&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;shadow=0;fillColor=#FFFAF8;strokeColor=#EB6C36;strokeWidth=1.2;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;overflow=fill;html=1;" vertex="1"><mxGeometry x="415" y="872" width="350" height="242" as="geometry" /></mxCell>
        <mxCell id="c1" parent="1" value="Accéder librement (sans compte)" edge="1" source="act_client" target="space_public" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#4F5D75;strokeWidth=1.2;endArrow=block;endFill=1;fontSize=9.5;fontColor:#2D3142;fontStyle=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c2" parent="1" value="S'authentifier par rôle (RBAC)" edge="1" source="act_internal" target="space_workspace" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#4F5D75;strokeWidth=1.2;endArrow=block;endFill=1;fontSize=9.5;fontColor:#2D3142;fontStyle=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c3" parent="1" value="Initier le tchat direct" edge="1" source="space_public" target="mod_conv" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#4F5D75;strokeWidth=1.2;endArrow=block;endFill=1;fontSize=9.5;fontColor:#2D3142;fontStyle=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c4" parent="1" value="Traiter les tickets SAV" edge="1" source="space_workspace" target="mod_tickets" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#4F5D75;strokeWidth=1.2;endArrow=block;endFill=1;fontSize=9.5;fontColor:#2D3142;fontStyle=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c5" parent="1" value="Piloter files &amp; compétences" edge="1" source="space_workspace" target="mod_team" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#4F5D75;strokeWidth=1.2;endArrow=block;endFill=1;fontSize=9.5;fontColor:#2D3142;fontStyle=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
