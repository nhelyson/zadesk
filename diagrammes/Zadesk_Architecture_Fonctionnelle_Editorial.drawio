  <diagram id="zadesk-functional-arch-editorial" name="Architecture Fonctionnelle Zadesk - Éditorial">
    <mxGraphModel dx="1600" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1040" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="lbl_zone_a" parent="1" value="&lt;b&gt;ZONE A — ACTEURS DU SYSTÈME&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor:#4F5D75;fontStyle=1;fontFamily=Georgia;" vertex="1"><mxGeometry x="55" y="20" width="300" height="20" as="geometry" /></mxCell>
        <mxCell id="lbl_zone_b" parent="1" value="&lt;b&gt;ZONE B — ESPACES D'ACCÈS &amp; CANAUX D'INTERACTION&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor:#4F5D75;fontStyle=1;fontFamily=Georgia;" vertex="1"><mxGeometry x="55" y="175" width="400" height="20" as="geometry" /></mxCell>
        <mxCell id="lbl_zone_c" parent="1" value="&lt;b&gt;ZONE C — MODULES FONCTIONNELS MÉTIER&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor:#4F5D75;fontStyle=1;fontFamily=Georgia;" vertex="1"><mxGeometry x="55" y="358" width="400" height="20" as="geometry" /></mxCell>
        <mxCell id="act_client" parent="1" value="&lt;div style=&quot;padding:8px 12px;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif;&quot;&gt;&lt;span style=&quot;font-size:9px;font-weight:700;color:#2D3142;background:#F1F5F9;border:1px solid #CBD5E1;padding:2px 6px;border-radius:3px;&quot;&gt;ACTEUR EXTERNE&lt;/span&gt;&lt;br/&gt;&lt;b style=&quot;font-size:14.5px;color:#2D3142;display:block;margin-top:5px;&quot;&gt;Client / Consommateur&lt;/b&gt;&lt;div style=&quot;font-size:11.5px;color:#334155;margin-top:6px;line-height:1.5;&quot;&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Accéder&lt;/b&gt; librement sur le web sans compte&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Déposer&lt;/b&gt; des réclamations &amp;amp; &lt;b style=&quot;color:#2D3142;&quot;&gt;Échanger&lt;/b&gt; par tchat&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;shadow=0;fillColor=#FFFFFF;strokeColor=#4F5D75;strokeWidth=1.0;verticalAlign=top;align=left;overflow=fill;html=1;" vertex="1"><mxGeometry x="55" y="44" width="350" height="102" as="geometry" /></mxCell>
        <mxCell id="act_agent" parent="1" value="&lt;div style=&quot;padding:8px 12px;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif;&quot;&gt;&lt;span style=&quot;font-size:9px;font-weight:700;color:#2D3142;background:#F1F5F9;border:1px solid #CBD5E1;padding:2px 6px;border-radius:3px;&quot;&gt;RÔLE OPÉRATIONNEL&lt;/span&gt;&lt;br/&gt;&lt;b style=&quot;font-size:14.5px;color:#2D3142;display:block;margin-top:5px;&quot;&gt;Conseiller SAV (Agent)&lt;/b&gt;&lt;div style=&quot;font-size:11.5px;color:#334155;margin-top:6px;line-height:1.5;&quot;&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Prendre en charge&lt;/b&gt; les tickets &amp;amp; &lt;b style=&quot;color:#2D3142;&quot;&gt;Respecter&lt;/b&gt; les SLA&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Dialoguer&lt;/b&gt; en direct &amp;amp; &lt;b style=&quot;color:#2D3142;&quot;&gt;Rédiger&lt;/b&gt; des notes d&apos;équipe&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;shadow=0;fillColor=#FFFFFF;strokeColor=#4F5D75;strokeWidth=1.0;verticalAlign=top;align=left;overflow=fill;html=1;" vertex="1"><mxGeometry x="435" y="44" width="350" height="102" as="geometry" /></mxCell>
        <mxCell id="act_manager" parent="1" value="&lt;div style=&quot;padding:8px 12px;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif;&quot;&gt;&lt;span style=&quot;font-size:9px;font-weight:700;color:#2D3142;background:#F1F5F9;border:1px solid #CBD5E1;padding:2px 6px;border-radius:3px;&quot;&gt;RÔLE D&apos;ENCADREMENT&lt;/span&gt;&lt;br/&gt;&lt;b style=&quot;font-size:14.5px;color:#2D3142;display:block;margin-top:5px;&quot;&gt;Superviseur SAV (Manager)&lt;/b&gt;&lt;div style=&quot;font-size:11.5px;color:#334155;margin-top:6px;line-height:1.5;&quot;&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Superviser&lt;/b&gt; les files d&apos;attente &amp;amp; la charge des agents&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Qualifier&lt;/b&gt; les compétences &amp;amp; &lt;b style=&quot;color:#2D3142;&quot;&gt;Administrer&lt;/b&gt; les agences&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;shadow=0;fillColor=#FFFFFF;strokeColor=#4F5D75;strokeWidth=1.0;verticalAlign=top;align=left;overflow=fill;html=1;" vertex="1"><mxGeometry x="815" y="44" width="350" height="102" as="geometry" /></mxCell>
        <mxCell id="act_admin" parent="1" value="&lt;div style=&quot;padding:8px 12px;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif;&quot;&gt;&lt;span style=&quot;font-size:9px;font-weight:700;color:#2D3142;background:#F1F5F9;border:1px solid #CBD5E1;padding:2px 6px;border-radius:3px;&quot;&gt;DIRECTION &amp;amp; GOUVERNANCE&lt;/span&gt;&lt;br/&gt;&lt;b style=&quot;font-size:14.5px;color:#2D3142;display:block;margin-top:5px;&quot;&gt;Administrateur (Owner / Admin)&lt;/b&gt;&lt;div style=&quot;font-size:11.5px;color:#334155;margin-top:6px;line-height:1.5;&quot;&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Inviter&lt;/b&gt; les collaborateurs &amp;amp; &lt;b style=&quot;color:#2D3142;&quot;&gt;Attribuer&lt;/b&gt; les rôles&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Souscrire&lt;/b&gt; via SasPay &amp;amp; &lt;b style=&quot;color:#2D3142;&quot;&gt;Paramétrer&lt;/b&gt; l&apos;assistance IA&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;shadow=0;fillColor=#FFFFFF;strokeColor=#4F5D75;strokeWidth=1.0;verticalAlign=top;align=left;overflow=fill;html=1;" vertex="1"><mxGeometry x="1195" y="44" width="350" height="102" as="geometry" /></mxCell>
        <mxCell id="space_public" parent="1" value="&lt;div style=&quot;padding:10px 14px;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif;&quot;&gt;&lt;span style=&quot;font-size:9px;font-weight:700;color:#2D3142;background:#F1F5F9;border:1px solid #CBD5E1;padding:2px 6px;border-radius:3px;&quot;&gt;ENVIRONNEMENT PUBLIC&lt;/span&gt;&lt;br/&gt;&lt;b style=&quot;font-size:15px;color:#2D3142;display:block;margin-top:5px;font-family:Georgia,serif;&quot;&gt;Portail Public SAV &amp;amp; Vitrine Commerciale&lt;/b&gt;&lt;div style=&quot;font-size:11.5px;color:#334155;margin-top:8px;line-height:1.5;&quot;&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Rechercher&lt;/b&gt; les commerces certifiés dans l&apos;annuaire (/entreprises)&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Consulter&lt;/b&gt; la vitrine, adresses et horaires SAV (/entreprises/[slug])&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Démarrer&lt;/b&gt; un tchat d&apos;assistance immédiat sécurisé par jeton&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;shadow=0;fillColor=#FFFFFF;strokeColor=#2D3142;strokeWidth=1.0;verticalAlign=top;align=left;overflow=fill;html=1;" vertex="1"><mxGeometry x="55" y="198" width="540" height="124" as="geometry" /></mxCell>
        <mxCell id="space_workspace" parent="1" value="&lt;div style=&quot;padding:10px 14px;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif;&quot;&gt;&lt;span style=&quot;font-size:9px;font-weight:700;color:#2D3142;background:#F1F5F9;border:1px solid #CBD5E1;padding:2px 6px;border-radius:3px;&quot;&gt;ESPACE ENTREPRISE MULTI-TENANT&lt;/span&gt;&lt;br/&gt;&lt;b style=&quot;font-size:15px;color:#2D3142;display:block;margin-top:5px;font-family:Georgia,serif;&quot;&gt;Espace Collaboratif Entreprise (Workspace Sécurisé)&lt;/b&gt;&lt;div style=&quot;display:flex;gap:12px;margin-top:8px;font-size:11px;line-height:1.45;&quot;&gt;  &lt;div style=&quot;flex:1;background:#F8FAFC;padding:6px 8px;border-radius:4px;border:1px solid #CBD5E1;&quot;&gt;    &lt;b style=&quot;color:#2D3142;&quot;&gt;Cockpit Conseiller&lt;/b&gt;&lt;br/&gt;    &lt;b style=&quot;color:#2D3142;&quot;&gt;Traiter&lt;/b&gt; tickets, &lt;b style=&quot;color:#2D3142;&quot;&gt;dialoguer&lt;/b&gt; &amp;amp; &lt;b style=&quot;color:#2D3142;&quot;&gt;suivre&lt;/b&gt; SLA  &lt;/div&gt;  &lt;div style=&quot;flex:1;background:#F8FAFC;padding:6px 8px;border-radius:4px;border:1px solid #CBD5E1;&quot;&gt;    &lt;b style=&quot;color:#2D3142;&quot;&gt;Console Supervision&lt;/b&gt;&lt;br/&gt;    &lt;b style=&quot;color:#2D3142;&quot;&gt;Piloter&lt;/b&gt; files, compétences &amp;amp; agences  &lt;/div&gt;  &lt;div style=&quot;flex:1;background:#F8FAFC;padding:6px 8px;border-radius:4px;border:1px solid #CBD5E1;&quot;&gt;    &lt;b style=&quot;color:#2D3142;&quot;&gt;Administration Générale&lt;/b&gt;&lt;br/&gt;    &lt;b style=&quot;color:#2D3142;&quot;&gt;Inviter&lt;/b&gt; l&apos;équipe, &lt;b style=&quot;color:#2D3142;&quot;&gt;payer&lt;/b&gt; SasPay &amp;amp; &lt;b style=&quot;color:#2D3142;&quot;&gt;régler&lt;/b&gt; l&apos;IA  &lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;shadow=0;fillColor=#FFFFFF;strokeColor=#2D3142;strokeWidth=1.0;verticalAlign=top;align=left;overflow=fill;html=1;" vertex="1"><mxGeometry x="635" y="198" width="910" height="124" as="geometry" /></mxCell>
        <mxCell id="mod_tickets" parent="1" value="&lt;div style=&quot;padding:10px 14px;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif;&quot;&gt;&lt;span style=&quot;font-size:9px;font-weight:700;color:#2D3142;background:#F1F5F9;border:1px solid #CBD5E1;padding:2px 6px;border-radius:3px;&quot;&gt;MODULE OPÉRATIONNEL&lt;/span&gt;&lt;br/&gt;&lt;b style=&quot;font-size:15px;color:#2D3142;display:block;margin-top:5px;font-family:Georgia,serif;&quot;&gt;1. Demandes &amp;amp; Tickets SAV&lt;/b&gt;&lt;div style=&quot;font-size:11px;color:#64748B;font-style:italic;margin-bottom:6px;&quot;&gt;Gestion formalisée et cycle de vie des réclamations&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #E2E8F0;margin:4px 0 8px 0;&quot;/&gt;&lt;div style=&quot;font-size:11.5px;color:#334155;line-height:1.5;&quot;&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Créer &amp;amp; Numéroter&lt;/b&gt; le dossier technique unique (TICK-ABC123)&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Ordonnancer&lt;/b&gt; le cycle SAV : PENDING → OPEN → IN_PROGRESS → RESOLVED&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Surveiller&lt;/b&gt; les engagements SLA avec alertes visuelles d&apos;échéance&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Tracer&lt;/b&gt; chaque événement dans le journal inaltérable (TicketActivity)&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Partager&lt;/b&gt; les dossiers entre succursales et ateliers (TicketShare)&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Joindre&lt;/b&gt; des pièces justificatives (factures, photos de panne)&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Clôturer &amp;amp; Documenter&lt;/b&gt; avec motif formel de résolution&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Consolider&lt;/b&gt; l&apos;historique complet des pannes sur la fiche client&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;shadow=0;fillColor=#FFFFFF;strokeColor=#2D3142;strokeWidth=1.0;verticalAlign=top;align=left;overflow=fill;html=1;" vertex="1"><mxGeometry x="55" y="380" width="470" height="285" as="geometry" /></mxCell>
        <mxCell id="mod_conv" parent="1" value="&lt;div style=&quot;padding:10px 14px;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif;&quot;&gt;&lt;span style=&quot;font-size:9px;font-weight:700;color:#2D3142;background:#F1F5F9;border:1px solid #CBD5E1;padding:2px 6px;border-radius:3px;&quot;&gt;MODULE OPÉRATIONNEL&lt;/span&gt;&lt;br/&gt;&lt;b style=&quot;font-size:15px;color:#2D3142;display:block;margin-top:5px;font-family:Georgia,serif;&quot;&gt;2. Conversations &amp;amp; Dialogue Direct&lt;/b&gt;&lt;div style=&quot;font-size:11px;color:#64748B;font-style:italic;margin-bottom:6px;&quot;&gt;Messagerie instantanée omnicanale et assistance en direct&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #E2E8F0;margin:4px 0 8px 0;&quot;/&gt;&lt;div style=&quot;font-size:11.5px;color:#334155;line-height:1.5;&quot;&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Échanger&lt;/b&gt; en temps réel entre client et conseiller SAV&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Générer&lt;/b&gt; une session client sécurisée par jeton sans compte&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Consigner&lt;/b&gt; des notes confidentielles invisibles pour le client&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Élever&lt;/b&gt; instantanément le fil de tchat en Ticket SAV avec historique&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Réceptionner&lt;/b&gt; des photos et documents justificatifs en direct&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Gérer&lt;/b&gt; les statuts de fil : active, suspendue ou clôturée&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Indiquer&lt;/b&gt; la présence et la saisie de message en direct&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Conserver&lt;/b&gt; l&apos;intégralité des échanges pour consultation ultérieure&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;shadow=0;fillColor=#FFFFFF;strokeColor=#2D3142;strokeWidth=1.0;verticalAlign=top;align=left;overflow=fill;html=1;" vertex="1"><mxGeometry x="565" y="380" width="470" height="285" as="geometry" /></mxCell>
        <mxCell id="mod_team" parent="1" value="&lt;div style=&quot;padding:10px 14px;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif;&quot;&gt;&lt;span style=&quot;font-size:9px;font-weight:700;color:#2D3142;background:#F1F5F9;border:1px solid #CBD5E1;padding:2px 6px;border-radius:3px;&quot;&gt;MODULE OPÉRATIONNEL&lt;/span&gt;&lt;br/&gt;&lt;b style=&quot;font-size:15px;color:#2D3142;display:block;margin-top:5px;font-family:Georgia,serif;&quot;&gt;3. Équipe, Compétences &amp;amp; Agences&lt;/b&gt;&lt;div style=&quot;font-size:11px;color:#64748B;font-style:italic;margin-bottom:6px;&quot;&gt;Organisation des ressources, qualifications et succursales&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #E2E8F0;margin:4px 0 8px 0;&quot;/&gt;&lt;div style=&quot;font-size:11.5px;color:#334155;line-height:1.5;&quot;&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Réguler&lt;/b&gt; la charge avec des plafonds de capacité (maxCapacity)&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Déclarer&lt;/b&gt; les disponibilités : AVAILABLE, BUSY, AWAY, OFFLINE&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Classifier&lt;/b&gt; les qualifications techniques dans la matrice (Skills)&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Affecter&lt;/b&gt; automatiquement selon compétences et charge active&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Administrer&lt;/b&gt; les succursales, ateliers SAV et horaires (Establishment)&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Réassigner&lt;/b&gt; manuellement les dossiers en cas de surcharge&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Auditer&lt;/b&gt; la charge de traitement en temps réel&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Coordonner&lt;/b&gt; les interventions techniques entre points de vente&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;shadow=0;fillColor=#FFFFFF;strokeColor=#2D3142;strokeWidth=1.0;verticalAlign=top;align=left;overflow=fill;html=1;" vertex="1"><mxGeometry x="1075" y="380" width="470" height="285" as="geometry" /></mxCell>
        <mxCell id="mod_sec" parent="1" value="&lt;div style=&quot;padding:10px 14px;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif;&quot;&gt;&lt;span style=&quot;font-size:9px;font-weight:700;color:#2D3142;background:#F1F5F9;border:1px solid #CBD5E1;padding:2px 6px;border-radius:3px;&quot;&gt;MODULE OPÉRATIONNEL&lt;/span&gt;&lt;br/&gt;&lt;b style=&quot;font-size:15px;color:#2D3142;display:block;margin-top:5px;font-family:Georgia,serif;&quot;&gt;4. Sécurité &amp;amp; Gestion des Accès&lt;/b&gt;&lt;div style=&quot;font-size:11px;color:#64748B;font-style:italic;margin-bottom:6px;&quot;&gt;Contrôle d&apos;accès, étanchéité multi-tenant et traçabilité&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #E2E8F0;margin:4px 0 8px 0;&quot;/&gt;&lt;div style=&quot;font-size:11.5px;color:#334155;line-height:1.5;&quot;&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Sécuriser&lt;/b&gt; les sessions par cookies HttpOnly, SameSite et OTP&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Contrôler&lt;/b&gt; strictement les autorisations par rôle (requireWorkspaceRole)&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Cloisonner&lt;/b&gt; hermétiquement les données de chaque organisation&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Garantir&lt;/b&gt; la persistance des événements via l&apos;Outbox Pattern&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Diffuser&lt;/b&gt; en temps réel via Server-Sent Events (Pulse Stream)&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Journaliser&lt;/b&gt; de façon inaltérable chaque action administrative (AuditLog)&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Bloquer&lt;/b&gt; les attaques par limitation de débit (Rate Limiting)&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Révoquer&lt;/b&gt; immédiatement les accès lors du départ d&apos;un collaborateur&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;shadow=0;fillColor=#FFFFFF;strokeColor=#2D3142;strokeWidth=1.0;verticalAlign=top;align=left;overflow=fill;html=1;" vertex="1"><mxGeometry x="55" y="695" width="470" height="295" as="geometry" /></mxCell>
        <mxCell id="mod_comm" parent="1" value="&lt;div style=&quot;padding:10px 14px;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif;&quot;&gt;&lt;span style=&quot;font-size:9px;font-weight:700;color:#2D3142;background:#F1F5F9;border:1px solid #CBD5E1;padding:2px 6px;border-radius:3px;&quot;&gt;MODULE OPÉRATIONNEL&lt;/span&gt;&lt;br/&gt;&lt;b style=&quot;font-size:15px;color:#2D3142;display:block;margin-top:5px;font-family:Georgia,serif;&quot;&gt;5. Facturation, Quotas &amp;amp; Abonnements&lt;/b&gt;&lt;div style=&quot;font-size:11px;color:#64748B;font-style:italic;margin-bottom:6px;&quot;&gt;Gestion commerciale, forfaits SaaS et paiements dématérialisés&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #E2E8F0;margin:4px 0 8px 0;&quot;/&gt;&lt;div style=&quot;font-size:11.5px;color:#334155;line-height:1.5;&quot;&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Tarifer&lt;/b&gt; selon les formules adaptées aux PME (Starter, Pro, Enterprise)&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Réguler&lt;/b&gt; dynamiquement les quotas d&apos;agents, tickets et agences&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Encaisser&lt;/b&gt; via SasPay par Mobile Money (Airtel, MTN) et cartes bancaires&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Valider&lt;/b&gt; automatiquement les paiements par webhooks asynchrones&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Éditer&lt;/b&gt; les factures comptables et l&apos;historique d&apos;abonnement&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Notifier&lt;/b&gt; l&apos;approche des échéances ou dépassements de quota&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Préserver&lt;/b&gt; l&apos;intégrité des données en cas de rétrogradation d&apos;offre&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Renouveler&lt;/b&gt; automatiquement les services à date anniversaire&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;shadow=0;fillColor=#FFFFFF;strokeColor=#2D3142;strokeWidth=1.0;verticalAlign=top;align=left;overflow=fill;html=1;" vertex="1"><mxGeometry x="565" y="695" width="470" height="295" as="geometry" /></mxCell>
        <mxCell id="mod_ai" parent="1" value="&lt;div style=&quot;padding:10px 14px;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif;&quot;&gt;&lt;span style=&quot;font-size:9px;font-weight:700;color:#EB6C36;background:#FDF0EB;border:1px solid #EB6C36;padding:2px 6px;border-radius:3px;&quot;&gt;ARCHITECTURE CIBLE • EN PRÉPARATION&lt;/span&gt;&lt;br/&gt;&lt;b style=&quot;font-size:15px;color:#2D3142;display:block;margin-top:5px;font-family:Georgia,serif;&quot;&gt;6. Assistance IA &amp;amp; RAG (Supervisée)&lt;/b&gt;&lt;div style=&quot;font-size:11px;color:#64748B;font-style:italic;margin-bottom:6px;&quot;&gt;Augmentation des conseillers et automatisation encadrée&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:1px solid #FDBA74;margin:4px 0 8px 0;&quot;/&gt;&lt;div style=&quot;font-size:11.5px;color:#334155;line-height:1.5;&quot;&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Ingérer&lt;/b&gt; la documentation d&apos;entreprise et manuels SAV (chunks)&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Rechercher&lt;/b&gt; sémantiquement &amp;amp; &lt;b style=&quot;color:#2D3142;&quot;&gt;Générer&lt;/b&gt; des réponses sourcées (Llama 3.3)&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Proposer&lt;/b&gt; des brouillons d&apos;assistance modifiables par le conseiller&lt;br/&gt;&lt;span style=&quot;color:#9A3412;&quot;&gt;&lt;b style=&quot;color:#EB6C36;&quot;&gt;Déclencher&lt;/b&gt; l&apos;escalade humaine obligatoire et immédiate :&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;color:#9A3412;&quot;&gt;&amp;nbsp;&amp;nbsp;1. Détection d&apos;irritation ou insatisfaction client&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;color:#9A3412;&quot;&gt;&amp;nbsp;&amp;nbsp;2. Litige ou contestation financière &amp;gt; 50 000 XAF&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;color:#9A3412;&quot;&gt;&amp;nbsp;&amp;nbsp;3. Demande explicite de prise en charge par un conseiller&lt;/span&gt;&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Superviser&lt;/b&gt; en continu avec score de confiance et validation humaine&lt;br/&gt;• &lt;b style=&quot;color:#2D3142;&quot;&gt;Enrichir&lt;/b&gt; dynamiquement les connaissances selon les retours agents&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;shadow=0;fillColor=#FFFAF8;strokeColor=#EB6C36;strokeWidth=1.2;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;overflow=fill;html=1;" vertex="1"><mxGeometry x="1075" y="695" width="470" height="295" as="geometry" /></mxCell>
