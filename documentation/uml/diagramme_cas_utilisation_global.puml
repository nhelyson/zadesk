@startuml
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 11
skinparam defaultFontColor #0F172A
skinparam nodesep 18
skinparam ranksep 48

' Frontière Système Zalisk (Cadre unique sans sous-boîtes)
skinparam rectangle {
  BorderColor #1E293B
  BorderThickness 1.8
  BackgroundColor #FFFFFF
  FontSize 14
  FontStyle bold
  FontColor #0F172A
}

' Styles des Cas d'Utilisation par Domaine Fonctionnel
skinparam usecase {
  BorderThickness 1.3
  FontSize 11
  FontColor #0F172A
}

' 1. Portail Public (Bleu pastel)
skinparam usecase<<public>> {
  BackgroundColor #EFF6FF
  BorderColor #3B82F6
  FontColor #1E3A8A
}

' 2. IA, RAG Interne & Inférence (Violet pastel)
skinparam usecase<<ai>> {
  BackgroundColor #FAF5FF
  BorderColor #9333EA
  FontColor #581C87
}

' 3. Traitement SAV Humain (Vert pastel)
skinparam usecase<<sav>> {
  BackgroundColor #ECFDF5
  BorderColor #10B981
  FontColor #064E3B
}

' 4. Supervision SAV (Ambre / Jaune pastel)
skinparam usecase<<supervision>> {
  BackgroundColor #FFFBEB
  BorderColor #F59E0B
  FontColor #78350F
}

' 5. Administration Entreprise (Ardoise / Gris-Bleu)
skinparam usecase<<admin>> {
  BackgroundColor #F8FAFC
  BorderColor #64748B
  FontColor #1E293B
}

' 6. Propriétaire Workspace (Magenta / Violet profond)
skinparam usecase<<owner>> {
  BackgroundColor #FDF2F8
  BorderColor #C026D3
  FontColor #701A75
}

' Styles des Acteurs UML
skinparam actor {
  BorderThickness 1.6
  FontSize 11
  FontStyle bold
}

skinparam actor<<client>> {
  BackgroundColor #EFF6FF
  BorderColor #2563EB
  FontColor #1E40AF
}

skinparam actor<<cloudflare>> {
  BackgroundColor #FAF5FF
  BorderColor #9333EA
  FontColor #7E22CE
}

skinparam actor<<agent>> {
  BackgroundColor #ECFDF5
  BorderColor #10B981
  FontColor #047857
}

skinparam actor<<manager>> {
  BackgroundColor #FFFBEB
  BorderColor #F59E0B
  FontColor #B45309
}

skinparam actor<<admin_actor>> {
  BackgroundColor #F8FAFC
  BorderColor #64748B
  FontColor #334155
}

skinparam actor<<owner_actor>> {
  BackgroundColor #FDF2F8
  BorderColor #C026D3
  FontColor #A21CAF
}

' Styles des Liens et Dépendances
skinparam arrow {
  Color #1E293B
  Thickness 1.3
  FontColor #475569
  FontSize 9.5
}

' ==============================================================================
' ACTEURS EXTERNES (GAUCHE DU SYSTÈME)
' ==============================================================================
actor "Client / Visiteur\n<size:10>(Grand Public)</size>" as client <<client>>
actor "Cloudflare Workers AI\n<size:10>«service» (Inférence LLM)</size>" as cloudflare <<cloudflare>>

' ==============================================================================
' SYSTÈME ZALISK (PÉRIMÈTRE UNIQUE ENCADRÉ)
' ==============================================================================
rectangle "SYSTÈME ZALISK" {

  ' --- COLONNE 1 : PORTAIL PUBLIC, ASSISTANCE RAG & INFÉRENCE MODÈLE ---
  usecase "Consulter l'annuaire des\nfiches assistance" as UC_Annuaire <<public>>
  usecase "Soumettre une demande SAV en ligne\n(avec création de ticket)" as UC_Soumettre <<public>>
  usecase "Échanger par messagerie temps réel\n(chat direct omnicanal)" as UC_Tchat <<public>>
  usecase "Suivre l'état d'avancement\nde sa demande SAV" as UC_Suivi <<public>>
  usecase "Obtenir une assistance automatisée\npar RAG (Moteur interne Zalisk)" as UC_AssistanceIA <<ai>>
  usecase "Solliciter un transfert vers\nun conseiller humain" as UC_TransfertHumain <<ai>>
  usecase "Exécuter l'inférence des modèles LLM\n(Génération texte Cloudflare Workers AI)" as UC_InferenceLLM <<ai>>

  ' --- COLONNE 2 : SUGGESTIONS COPILOTE & TRAITEMENT SAV OPÉRATEUR ---
  usecase "Écouter les suggestions de\nréponses formulées par l'IA" as UC_SuggestionsIA <<ai>>
  usecase "Gérer son statut\nde disponibilité" as UC_Dispo <<sav>>
  usecase "Traiter les conversations clients\net demandes en attente" as UC_TraiterConv <<sav>>
  usecase "Élever une conversation\nen Ticket SAV officiel" as UC_EleverTicket <<sav>>
  usecase "Rédiger des notes\ninternes d'équipe" as UC_NotesInternes <<sav>>
  usecase "Partager un ticket à d'autres agents\n(entraide collaborative)" as UC_PartagerTicket <<sav>>
  usecase "Gérer le cycle de vie\ndes tickets SAV (SLA)" as UC_TraiterTicket <<sav>>

  ' --- COLONNE 3 : SUPERVISION, ADMINISTRATION & GOUVERNANCE WORKSPACE ---
  usecase "Superviser les files d'attente\net la charge de travail" as UC_SuperviserFiles <<supervision>>
  usecase "Consulter les tableaux de bord\nanalytiques et le respect SLA" as UC_ConsulterStats <<supervision>>
  usecase "Gérer les établissements\nde l'entreprise" as UC_GererEtablissements <<supervision>>
  usecase "Définir et attribuer les\ncompétences agents (Skills)" as UC_GererCompetences <<supervision>>
  usecase "Réaffecter manuellement un\nticket ou une conversation" as UC_Reassigner <<supervision>>

  usecase "Suspendre ou réactiver\nl'accès d'un collaborateur" as UC_SuspendreMembre <<admin>>
  usecase "Inviter des membres et\nattribuer les rôles (RBAC)" as UC_GererMembres <<admin>>
  usecase "Administrer la base documentaire\npour le RAG (Articles & FAQ)" as UC_GererKnowledge <<admin>>
  usecase "Configurer les paramètres de\nl'entreprise (canaux, horodatage)" as UC_ParametresWorkspace <<admin>>

  usecase "Gérer l'abonnement SaaS\net les paiements Stripe" as UC_GererAbonnement <<owner>>
  usecase "Supprimer définitivement\nl'espace de travail" as UC_SupprimerWorkspace <<owner>>
}

' ==============================================================================
' ACTEURS INTERNES (DROITE DU SYSTÈME)
' ==============================================================================
actor "Conseiller SAV\n<size:10>(AGENT)</size>" as agent <<agent>>
actor "Superviseur SAV\n<size:10>(MANAGER)</size>" as manager <<manager>>
actor "Administrateur\n<size:10>(ADMIN)</size>" as admin <<admin_actor>>
actor "Propriétaire\n<size:10>(OWNER)</size>" as owner <<owner_actor>>

' ==============================================================================
' ASSOCIATIONS ACTEURS <--> CAS D'UTILISATION (LIGNES DIRECTES SANS CROISEMENTS)
' ==============================================================================

' Client (Gauche)
client -- UC_Annuaire
client -- UC_Soumettre
client -- UC_Tchat
client -- UC_Suivi

' Cloudflare Workers AI (Gauche Bas - strictement fournisseur d'inférence LLM)
cloudflare -- UC_InferenceLLM

' Relations IA & RAG
UC_Tchat ..> UC_AssistanceIA : <<include>>
UC_AssistanceIA ..> UC_InferenceLLM : <<include>>
UC_AssistanceIA <.. UC_TransfertHumain : <<extend>>\n[seuil escalade]
UC_TransfertHumain ..> UC_TraiterConv : <<extend>>\n[file attente]
UC_SuggestionsIA ..> UC_InferenceLLM : <<include>>
UC_SuggestionsIA ..> UC_TraiterConv : <<extend>>\n[assistance active]

' Relations Internes Conseiller SAV
UC_TraiterConv <.. UC_EleverTicket : <<extend>>
UC_TraiterConv <.. UC_NotesInternes : <<extend>>
UC_TraiterTicket <.. UC_PartagerTicket : <<extend>>\n[besoin expertise]

' Conseiller SAV (Droite - Accès direct aux cas opératoires de base)
agent -- UC_Dispo
agent -- UC_TraiterConv
agent -- UC_TraiterTicket

' Superviseur SAV (Droite - Pilotage opérationnel & SLA)
manager -- UC_SuperviserFiles
manager -- UC_ConsulterStats
manager -- UC_GererEtablissements
manager -- UC_GererCompetences
manager -- UC_Reassigner

' Administrateur (Droite - Gouvernance & Base RAG)
admin -- UC_SuspendreMembre
admin -- UC_GererMembres
admin -- UC_GererKnowledge
admin -- UC_ParametresWorkspace

' Propriétaire (Droite - Espace & Facturation)
owner -- UC_GererAbonnement
owner -- UC_SupprimerWorkspace

@enduml
