# ==========================================
# ENV VARIABLES - ZADESK SAAS
# ==========================================

# APPLICATION & ENVIRONNEMENT
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost
NEXT_PUBLIC_APP_NAME=Zadesk
NEXT_PUBLIC_APP_URL=http://localhost
NEXT_PUBLIC_API_URL=/api

# BASE DE DONNEES POSTGRESQL (DOCKER / LOCAL)
# En local (sans docker pour le backend): postgresql://zadesk:zadesk_password@localhost:5432/zadesk?schema=public
# Dans Docker Compose: postgresql://zadesk:zadesk_password@postgres:5432/zadesk?schema=public
DATABASE_URL=postgresql://zadesk:zadesk_password@postgres:5432/zadesk?schema=public
POSTGRES_DB=zadesk
POSTGRES_USER=zadesk
POSTGRES_PASSWORD=zadesk_password

# AUTHENTIFICATION & SESSIONS
SESSION_SECRET=change_me_super_secret_session_key_zadesk_2026_congo
SESSION_MAX_AGE_DAYS=7

# GOOGLE OAUTH / IDENTITY SERVICES
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# REDIS & BULLMQ (POUR LES FUTURS MODULES)
REDIS_URL=redis://redis:6379

# ZAVU EMAIL & OTP PROVIDER
ZAVUDEV_API_KEY=
OTP_EXPIRATION_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
