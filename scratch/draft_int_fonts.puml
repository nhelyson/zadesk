@startuml
skinparam shadowing false
skinparam backgroundColor #F8F9FA
skinparam defaultTextAlignment left
skinparam roundCorner 8
skinparam packageTitleAlignment left
skinparam wrapWidth 240

<style>
root {
  FontName "Helvetica"
  FontSize 11
  FontColor #2D3142
  LineColor #CBD5E1
}
header {
  FontName "Georgia"
  FontSize 13
  FontStyle bold
  FontColor #2D3142
}
package {
  FontName "Georgia"
  FontSize 12
  FontStyle bold
  FontColor #2D3142
  LineColor #4F5D75
  LineThickness 1.2
  BackgroundColor #FFFFFF
}
rectangle {
  RoundCorner 6
  LineColor #CBD5E1
  LineThickness 1.0
  BackgroundColor #FFFFFF
  FontColor #334155
  FontSize 11
}
actor {
  FontName "Helvetica"
  FontSize 11
  FontStyle bold
  FontColor #2D3142
  LineColor #4F5D75
  BackgroundColor #FFFFFF
}
arrow {
  LineColor #4F5D75
  FontColor #2D3142
  FontSize 10
  LineThickness 1.1
}
.target {
  LineColor #EB6C36
  LineStyle 4-3
  LineThickness 1.2
  BackgroundColor #FFFAF8
}
.accentBadge {
  FontColor #EB6C36
  FontStyle bold
}
</style>

' ==============================================================================
' 1. ACTEURS DU SYSTÈME (Section 4)
' ==============================================================================

package "Acteur Externe" as p_ext #FFFFFF {
  actor "Client\n<size:9><color:#64748B>(Consommateur)</color></size>" as client
}

package "Acteurs Internes (Workspace Entreprise)" as p_int #FFFFFF {
  actor "Conseiller SAV\n<size:9><color:#64748B>(AGENT)</color></size>" as agent
  actor "Superviseur SAV\n<size:9><color:#64748B>(MANAGER)</color></size>" as manager
  actor "Administrateur\n<size:9><color:#64748B>(ADMIN)</color></size>" as admin
  actor "Propriétaire\n<size:9><color:#64748B>(OWNER)</color></size>" as owner
}

' ==============================================================================
' 2. ESPACES FONCTIONNELS ET MODULES (Sections 5 & 6)
' ==============================================================================

package "PORTAIL PUBLIC (Accès libre sur le Web sans compte)" as p_portal #F8FAFC {
  rectangle "<b>Annuaire des Entreprises</b>\n---\n• Recherche commerces certifiés\n• Filtrage sectoriel et local" as pub_annuaire
  rectangle "<b>Vitrine & Informations Entreprise</b>\n---\n• Présentation et coordonnées\n• Adresses & horaires établissements\n  <i><size:9.5><color:#64748B>(si configurés par l'entreprise)</color></size></i>" as pub_vitrine
  rectangle "<b>Soumission d'Assistance SAV</b>\n---\n• Formulaire de réclamation directe\n• Pièces justificatives et description\n• Dépôt sans obligation de compte" as pub_soumission
  rectangle "<b>Tchat en Direct & Suivi</b>\n---\n• Dialogue instantané avec le SAV\n• Session sécurisée par jeton public\n• Consultation de l'avancement" as pub_tchat
  
  pub_annuaire -down-> pub_vitrine
  pub_vitrine -down-> pub_soumission
  pub_vitrine -down-> pub_tchat
}

package "WORKSPACE ENTREPRISE (Espace Collaboratif Multi-Tenant Sécurisé)" as p_ws #F8FAFC {
  
  package "Cœur Opérationnel SAV" as grp_sav #FFFFFF {
    rectangle "<b>Gestion des Tickets SAV</b>\n---\n• Numérotation unique (TICK-ABC)\n• Cycle : OPEN → IN_PROGRESS → RESOLVED\n• Surveillance SLA et alertes d'échéance\n• Journal d'activité (TicketActivity)\n• Partage inter-agences (TicketShare)" as mod_tickets
    
    rectangle "<b>Conversations & Dialogue Direct</b>\n---\n• Messagerie instantanée omnicanale\n• Prise en charge des tchats clients\n• Notes internes d'équipe confidentielles\n• Élévation directe en Ticket SAV" as mod_conv
  }
  
  package "Organisation & Gouvernance" as grp_gov #FFFFFF {
    rectangle "<b>Équipe & Compétences</b>\n---\n• Statuts présence (AVAILABLE, BUSY...)\n• Plafonds de charge (maxCapacity)\n• Matrice de compétences (Skills)\n• Affectation automatique & manuelle" as mod_team
    
    rectangle "<b>Établissements & Succursales</b>\n<i><size:9.5><color:#64748B>(Module optionnel selon l'entreprise)</color></size></i>\n---\n• Réseau d'agences et ateliers SAV\n• Horaires, adresses et coordonnées\n• Affectation géographique des agents" as mod_etab
    
    rectangle "<b>Membres, Rôles & Accès</b>\n---\n• Invitations par email et gestion RBAC\n• Rôles : OWNER, ADMIN, MANAGER, AGENT\n• Traçabilité et journal d'audit (AuditLog)\n• Suspension et révocation des accès" as mod_members
    
    rectangle "<b>Paramètres & Abonnements</b>\n---\n• Profil d'entreprise, coordonnées & SLA\n• Forfaits SaaS (Starter, Pro, Enterprise)\n• Paiements SasPay (Mobile Money / Cartes)\n• Régulation dynamique des quotas" as mod_billing
  }
  
  package "Assistance par Intelligence Artificielle (RAG)" as grp_ai <<target>> {
    rectangle "<b>Module d'Assistance IA (RAG)</b>\n<size:9.5><color:#EB6C36><b><<Composante cible • En préparation>></b></color></size>\n---\n• Base documentaire de référence entreprise\n• Recherche sémantique vectorielle (chunks)\n• Suggestions de réponses pré-rédigées (Llama)\n• <b>Escalade humaine immédiate obligatoire :</b>\n  1. Détection d'irritation client\n  2. Litige financier > 50 000 XAF\n  3. Demande explicite de conseiller humain" as mod_ai <<target>>
  }
}

' ==============================================================================
' 3. RELATIONS ET FLUX FONCTIONNELS
' ==============================================================================

' Accès des acteurs aux espaces
client -down-> p_portal : <b>Accède librement</b>\n(sans compte)

agent -down-> grp_sav : <b>Traite & résout</b>\n(tickets et tchats)
manager -down-> grp_gov : <b>Supervise</b>\n(files, équipes & agences)
admin -down-> grp_gov : <b>Administre</b>\n(membres, rôles & paramètres)
owner -down-> grp_gov : <b>Gouverne & finance</b>\n(abonnements SasPay & propriété)

' Interactions inter-espaces
pub_soumission -down-> mod_tickets : <b>Transmet la demande</b>\n(création ticket sans compte)
pub_tchat <-right-> mod_conv : <b>Échanges en direct</b>\n(session sécurisée par jeton)

' Coordination interne
mod_conv -left-> mod_tickets : <b>Élève en Ticket SAV</b>\n(si intervention requise)
mod_team -up-> mod_tickets : <b>Affecte selon profil</b>\n(compétences & charge)

' Interactions IA (RAG) vers modules opérationnels
mod_ai .up.> mod_conv : <color:#EB6C36><b>Suggère des réponses</b></color>\n<color:#EB6C36>(brouillons RAG)</color>
mod_ai .up.> mod_tickets : <color:#EB6C36><b>Escalade obligatoire</b></color>\n<color:#EB6C36>(litige > 50k / alerte)</color>

@enduml
