        <mxCell id="uc_auto_assign" value="Attribuer automatiquement un ticket&lt;br/&gt;&lt;span style=&quot;font-size:10px;color:#78350F;&quot;&gt;(Selon compétences &amp;amp; charge max)&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=2;fontColor=#92400E;fontSize=12;fontStyle=1;shadow=1;" vertex="1" parent="1">
