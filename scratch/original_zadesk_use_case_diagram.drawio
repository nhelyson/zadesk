        <mxCell id="title" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;b style=&quot;font-size:24px;color:#0F172A;&quot;&gt;ZADESK — DIAGRAMME DES CAS D'UTILISATION (USE CASE)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;color:#64748B;&quot;&gt;Plateforme SaaS SAV Omnicanale — Portail Public, Gestion des Tickets, Hub Conversations &amp;amp; Administration&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
